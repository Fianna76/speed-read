<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup rules for Android 11 and lower. Only preferences are backed up to the cloud: the
    library is rebuilt by re-importing packs, and notes PDFs can be large (the quota is 25 MB).
-->
<full-backup-content>
    <include domain="file" path="datastore/" />
</full-backup-content>
